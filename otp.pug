extends layouts/main.pug

block content
    .row.justify-content-center.mt-5
        .col-md-5
            .card.shadow-lg.border-0.text-center
                .card-header.bg-warning.text-dark.p-4
                    h2.mb-0 Verify Your Email
                    p.small.mb-0 A 6-digit code was sent to you
                .card-body.p-5
                    form(action="/verify-otp" method="POST")
                        .mb-4
                            label.form-label Enter 6-digit OTP
                            input.form-control.form-control-lg.text-center(type="text" name="otp" required maxlength="6" pattern="[0-9]{6}" placeholder="123456")
                        .d-grid.mb-3
                            button.btn.btn-primary.btn-lg(type="submit") Verify & Continue
                        p.text-muted Didn't receive code? 
                            a(href="/resend-otp") Resend OTP
                    .mt-4.p-3.bg-light.rounded.border
                        p.small.mb-0.text-info **Hint:** For testing, find your OTP in the 'otps' table of your database.
