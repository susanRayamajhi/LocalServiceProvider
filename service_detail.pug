extends layouts/main.pug

block content
    .container.mt-5
        .row
            .col-lg-8.mx-auto
                .card.shadow
                    .card-header.bg-primary.text-white
                        h1.h3.mb-0= service.name
                    .card-body
                        h5.text-muted Category: #{service.category_name}
                        p.mt-4.lead= service.description
                        p.h4.text-primary Price: $#{service.base_price}
                        
                        hr.my-4
                        
                        h3 Available Providers
                        if providers.length > 0
                            .list-group.mt-3
                                each provider in providers
                                    a.list-group-item.list-group-item-action(href=`/providers/${provider.id}`)
                                        .d-flex.w-100.justify-content-between
                                            h5.mb-1= provider.name
                                            small.text-warning Rating: #{provider.rating} ⭐
                                        p.mb-1= provider.description
                                        .d-flex.justify-content-end
                                            a.btn.btn-sm.btn-success(href=`/book/${service.id}`) Book Now
                        else
                            p.text-muted No providers currently offering this service.
                        
                        .mt-4
                            a.btn.btn-outline-secondary(href="/services") &laquo; Back to All Services
