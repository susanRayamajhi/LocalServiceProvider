extends layouts/main.pug

block content
    h1.my-5.text-center Our Services
    .row
        each service in services
            .col-md-4.mb-4
                .card.h-100.shadow-sm
                    .card-body
                        h5.card-title= service.name
                        h6.card-subtitle.mb-2.text-muted= service.category_name
                        p.card-text= service.description
                        p.card-text.fw-bold Base Price: $#{service.base_price}
                        a.btn.btn-primary(href=`/services/${service.id}`) View Details
