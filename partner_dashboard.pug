extends layouts/main.pug

block content
    .row.mt-5
        .col-md-3
            .list-group.shadow-sm
                a.list-group-item.list-group-item-action.active(href="/partner/dashboard") Overview
                a.list-group-item.list-group-item-action(href="/partner/bookings") My Bookings
                a.list-group-item.list-group-item-action(href="/partner/availability") Manage Availability
                a.list-group-item.list-group-item-action(href="/partner/earnings") Earnings & Payouts
                a.list-group-item.list-group-item-action(href="/partner/profile") Edit Profile
        
        .col-md-9
            h2 Welcome, #{partner.name}!
            p Here is a summary of your activity from the database.

            .row.mt-4
                .col-md-4
                    .card.bg-primary.text-white.text-center.mb-3
                        .card-body
                            h5 Pending Bookings
                            h2.display-5 #{pendingCount}
                .col-md-4
                    .card.bg-success.text-white.text-center.mb-3
                        .card-body
                            h5 Total Earnings
                            h2.display-5 $#{totalEarnings}
                .col-md-4
                    .card.bg-info.text-white.text-center.mb-3
                        .card-body
                            h5 Rating
                            h2.display-5 #{partner.rating}★
            
            .card.mt-4.shadow-sm
                .card-header.bg-white
                    h5.mb-0 Recent Bookings (Real-time)
                .card-body
                    table.table.table-hover
                        thead
                            tr
                                th ID
                                th Customer
                                th Service
                                th Status
                        tbody
                            each b in recentBookings
                                tr
                                    td ##{b.id}
                                    td= b.customer_name
                                    td= b.service_name
                                    td 
                                        span.badge(class=`bg-${b.status === 'Pending' ? 'warning' : b.status === 'Completed' ? 'success' : 'info'}`)= b.status
