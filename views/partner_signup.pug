extends layouts/main.pug

block content
    .container.py-5
        .row.justify-content-center
            .col-lg-8
                .card.shadow-lg.border-0
                    .card-header.bg-primary.text-white.text-center.p-4.border-0
                        h2.fw-bold.mb-0 Join as a Service Partner
                        p.opacity-75.small.mb-0 Start growing your professional business with us today
                    
                    .card-body.p-5
                        if error
                            .alert.alert-danger.alert-dismissible.fade.show(role="alert")
                                i.fas.fa-exclamation-circle.me-2
                                = error
                                button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Close")
                        
                        form(action="/api/partners/signup" method="POST")
                            .row.g-3.mb-4
                                .col-md-6
                                    label.form-label.fw-bold Business/Full Name
                                    .input-group
                                        span.input-group-text.bg-white: i.fas.fa-briefcase.text-muted
                                        input.form-control(type="text" name="name" required placeholder="Fix-It Services")
                                .col-md-6
                                    label.form-label.fw-bold Email Address
                                    .input-group
                                        span.input-group-text.bg-white: i.fas.fa-envelope.text-muted
                                        input.form-control(type="email" name="email" required placeholder="partner@example.com")
                            
                            .row.g-3.mb-4
                                .col-md-6
                                    label.form-label.fw-bold Phone Number
                                    .input-group
                                        span.input-group-text.bg-white: i.fas.fa-phone.text-muted
                                        input.form-control(type="tel" name="phone" required placeholder="9876543210")
                                .col-md-6
                                    label.form-label.fw-bold Password
                                    .input-group
                                        span.input-group-text.bg-white: i.fas.fa-lock.text-muted
                                        input.form-control(type="password" name="password" required placeholder="••••••••")
                            
                            .row.g-3.mb-4
                                .col-md-12
                                    label.form-label.fw-bold Primary Service Category
                                    .input-group
                                        span.input-group-text.bg-white: i.fas.fa-tags.text-muted
                                        select.form-select(name="service_id" required)
                                            option(value="") Select a service...
                                            if services
                                                each s in services
                                                    option(value=s.id)= s.name
                            
                            .mb-4
                                label.form-label.fw-bold About Your Experience
                                textarea.form-control(name="description" rows="3" placeholder="Tell us about your professional background and skills...")
                            
                            .row.g-3.mb-4
                                .col-md-6
                                    label.form-label.fw-bold Base Pricing ($ / task)
                                    .input-group
                                        span.input-group-text.bg-white: i.fas.fa-dollar-sign.text-muted
                                        input.form-control(type="number" name="pricing" required placeholder="50")
                                .col-md-6
                                    label.form-label.fw-bold Experience (Years)
                                    .input-group
                                        span.input-group-text.bg-white: i.fas.fa-history.text-muted
                                        input.form-control(type="number" name="experience" required placeholder="5")
                            
                            .mb-5
                                label.form-label.fw-bold Profile Image URL
                                .input-group
                                    span.input-group-text.bg-white: i.fas.fa-image.text-muted
                                    input.form-control(type="text" name="profile_image" placeholder="https://example.com/photo.jpg")
                                p.text-muted.small.mt-1 Provide a URL to your professional headshot or logo.
                            
                            .d-grid
                                button.btn.btn-primary.btn-lg(type="submit") 
                                    i.fas.fa-check-circle.me-2
                                    | Submit My Application
                    
                    .card-footer.bg-light.text-center.py-3.border-0
                        p.mb-0 Already a partner? 
                            a.fw-bold(href="/partner/login") Sign In here
