extends layouts/main.pug

block content
    .hero-section.text-center.py-5.mb-5.bg-primary.text-white.rounded-3
        h1.display-4.fw-bold Professional Services at Your Doorstep
        p.lead Find the best local experts for your home needs - from plumbing to painting.
        a.btn.btn-light.btn-lg(href="/services") Explore Services
        a.btn.btn-outline-light.btn-lg.ms-3(href="/signup") Join as User

    .container.my-5
        .row.text-center
            .col-md-4
                .card.h-100.shadow-sm.border-0
                    .card-body
                        h3.h5 Verified Partners
                        p Every service provider is vetted and background-checked for your safety.
            .col-md-4
                .card.h-100.shadow-sm.border-0
                    .card-body
                        h3.h5 Easy Booking
                        p Book services in just a few clicks and manage them all from your dashboard.
            .col-md-4
                .card.h-100.shadow-sm.border-0
                    .card-body
                        h3.h5 Secure Payments
                        p Multiple payment options with secure transaction processing.

    section.popular-services.py-5
        h2.text-center.mb-5 Popular Services
        .row
            each service in services
                .col-md-4.mb-4
                    .card.h-100.shadow-sm
                        img.card-img-top(src=`/images/${service.image || 'default-service.png'}` alt=service.name style="height: 200px; object-fit: cover;")
                        .card-body
                            h5.card-title= service.name
                            p.card-text.text-muted= service.description
                            p.fw-bold Starts from $#{service.base_price}
                            a.btn.btn-primary.w-100(href=`/services/${service.id}`) Book Now
        .text-center.mt-4
            a.btn.btn-outline-primary(href="/services") View All Services

    section.how-it-works.py-5.bg-light.rounded-3
        h2.text-center.mb-5 How It Works
        .row
            .col-md-3.text-center
                span.badge.bg-primary.rounded-pill.fs-4.mb-3 1
                h4 Choose Service
                p Select from a wide range of categories.
            .col-md-3.text-center
                span.badge.bg-primary.rounded-pill.fs-4.mb-3 2
                h4 Select Partner
                p Pick a professional based on ratings and experience.
            .col-md-3.text-center
                span.badge.bg-primary.rounded-pill.fs-4.mb-3 3
                h4 Schedule
                p Pick a date and time that works for you.
            .col-md-3.text-center
                span.badge.bg-primary.rounded-pill.fs-4.mb-3 4
                h4 Get it Done
                p Relax while our experts take care of the rest.
