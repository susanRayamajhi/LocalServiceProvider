extends ../layouts/main.pug

block content
    .container.py-5
        .row.justify-content-center
            .col-md-5
                .card.shadow-lg.p-4.border-0
                    .text-center.mb-4
                        .feature-icon.mx-auto
                            i.fas.fa-shield-alt
                        h2.fw-bold Verify OTP
                        p.text-muted We've sent a 6-digit code to your email
                        p.fw-bold.text-primary= email
                    
                    if error
                        .alert.alert-danger.alert-dismissible.fade.show(role="alert")
                            i.fas.fa-exclamation-circle.me-2
                            = error
                            button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Close")
                    
                    form(action="/api/auth/verify-otp" method="POST")
                        input(type="hidden" name="email" value=email)
                        input(type="hidden" name="type" value=type || 'user')
                        
                        .mb-4
                            label.form-label.fw-bold.text-center.d-block(for="otp") Enter 6-Digit Code
                            input#otp.form-control.form-control-lg.text-center.letter-spacing-lg(type="text" name="otp" maxlength="6" placeholder="000000" required style="font-size: 2rem; letter-spacing: 0.5rem;")
                        
                        .d-grid
                            button.btn.btn-primary.btn-lg(type="submit")
                                i.fas.fa-check-circle.me-2
                                | Verify & Complete
                    
                    .text-center.mt-4
                        p.mb-0 Didn't receive the code? 
                            a.text-primary.fw-bold(href="#") Resend OTP
                        p.mt-2.small.text-muted
                            i.fas.fa-info-circle.me-1
                            | Check your console logs for the code in this demo.
