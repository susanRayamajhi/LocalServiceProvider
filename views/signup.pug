extends layouts/main.pug

block content
    .container.py-5
        .row.justify-content-center
            .col-md-6
                .card.shadow-lg.p-4.border-0
                    .text-center.mb-4
                        .feature-icon.mx-auto
                            i.fas.fa-user-plus
                        h2.fw-bold Get Started
                        p.text-muted Join our community of happy customers
                    
                    if error
                        .alert.alert-danger.alert-dismissible.fade.show(role="alert")
                            i.fas.fa-exclamation-circle.me-2
                            = error
                            button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Close")
                    
                    form(action="/api/auth/signup" method="POST")
                        .row
                            .col-md-6.mb-3
                                label.form-label.fw-bold(for="name") Full Name
                                .input-group
                                    span.input-group-text.bg-white: i.fas.fa-user.text-muted
                                    input#name.form-control(type="text" name="name" placeholder="John Doe" required)
                            .col-md-6.mb-3
                                label.form-label.fw-bold(for="phone") Phone Number
                                .input-group
                                    span.input-group-text.bg-white: i.fas.fa-phone.text-muted
                                    input#phone.form-control(type="tel" name="phone" placeholder="1234567890")
                        
                        .mb-3
                            label.form-label.fw-bold(for="email") Email Address
                            .input-group
                                span.input-group-text.bg-white: i.fas.fa-envelope.text-muted
                                input#email.form-control(type="email" name="email" placeholder="name@example.com" required)
                        
                        .mb-4
                            label.form-label.fw-bold(for="password") Password
                            .input-group
                                span.input-group-text.bg-white: i.fas.fa-key.text-muted
                                input#password.form-control(type="password" name="password" placeholder="••••••••" required)
                        
                        .d-grid
                            button.btn.btn-primary.btn-lg(type="submit")
                                i.fas.fa-user-check.me-2
                                | Create My Account
                    
                    .text-center.mt-4
                        p.mb-0 Already have an account? 
                            a.text-primary.fw-bold(href="/login") Sign In
                        p.mt-3.small.text-muted
                            | By creating an account, you agree to our 
                            a(href="#") Terms & Conditions
                            |  and 
                            a(href="#") Privacy Policy
