extends layouts/main.pug

block content
    .hero-section.text-center.py-5.mb-5
        .container
            img.rounded-circle.shadow-lg.mb-4(src=provider.profile_image || "https://ui-avatars.com/api/?name="+provider.name+"&background=fff&color=3182ce&size=150" alt=provider.name style="width: 150px; height: 150px; border: 5px solid rgba(255,255,255,0.2);")
            h1.display-4.fw-bold.mb-2= provider.name
            .d-flex.justify-content-center.gap-2.mb-3
                span.badge.bg-white.text-primary.px-3.py-2.rounded-pill
                    i.fas.fa-star.text-warning.me-1
                    | #{provider.rating || '0.00'} / 5.00 Rating
                span.badge.bg-white.text-success.px-3.py-2.rounded-pill
                    i.fas.fa-check-circle.me-1
                    | Verified Professional

    .container.pb-5
        .row.g-4
            .col-lg-4
                .card.shadow-sm.p-4.border-0.h-100
                    h4.h5.fw-bold.mb-4 Professional Info
                    ul.list-unstyled
                        li.mb-3.d-flex.align-items-center
                            .feature-icon.m-0.me-3(style="width: 40px; height: 40px; font-size: 1rem;")
                                i.fas.fa-history
                            div
                                small.text-muted.d-block Experience
                                span.fw-bold= provider.experience || '0'
                                |  Years
                        li.mb-3.d-flex.align-items-center
                            .feature-icon.m-0.me-3(style="width: 40px; height: 40px; font-size: 1rem;")
                                i.fas.fa-dollar-sign
                            div
                                small.text-muted.d-block Starting Price
                                span.fw-bold $#{provider.pricing || '0'}
                                |  / task
                        li.mb-3.d-flex.align-items-center
                            .feature-icon.m-0.me-3(style="width: 40px; height: 40px; font-size: 1rem;")
                                i.fas.fa-envelope
                            div
                                small.text-muted.d-block Email Address
                                span.fw-bold= provider.email
                        li.mb-0.d-flex.align-items-center
                            .feature-icon.m-0.me-3(style="width: 40px; height: 40px; font-size: 1rem;")
                                i.fas.fa-phone
                            div
                                small.text-muted.d-block Phone Number
                                span.fw-bold= provider.phone

            .col-lg-8
                .card.shadow-sm.p-4.border-0.mb-4
                    h4.h5.fw-bold.mb-3 About the Provider
                    p.text-muted= provider.description || "No description provided."
                
                .card.shadow-sm.p-4.border-0
                    h4.h5.fw-bold.mb-4 Services Offered
                    if services && services.length > 0
                        .row.g-3
                            each service in services
                                .col-md-6
                                    .p-3.border.rounded-3.d-flex.justify-content-between.align-items-center
                                        div
                                            h6.mb-1.fw-bold= service.name
                                            small.text-muted Service details available
                                        a.btn.btn-primary.btn-sm(href=`/book/${service.id}?partner_id=${provider.id}`) Book Now
                    else
                        .text-center.py-4
                            p.text-muted No specific services listed.
                            a.btn.btn-outline-primary(href="/services") Browse All Services

        .text-center.mt-5
            a.btn.btn-link.text-muted(href="/providers")
                i.fas.fa-arrow-left.me-2
                | Back to Providers List
