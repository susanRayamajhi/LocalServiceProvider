extends layouts/main.pug

block content
    .container.py-5
        .d-flex.justify-content-between.align-items-center.mb-4
            h1.h3 My Bookings
            a.btn.btn-primary(href="/services") Book New Service

        if bookings && bookings.length > 0
            .row
                each booking in bookings
                    .col-md-6.mb-4
                        .card.shadow-sm.border-0
                            .card-body
                                .d-flex.justify-content-between.align-items-start.mb-3
                                    div
                                        h5.card-title.mb-1= booking.service_name
                                        p.text-muted.small.mb-0 Provider: #{booking.partner_name}
                                    span.badge.bg-info.text-dark= booking.status
                                
                                .row.mb-3
                                    .col-6
                                        p.small.text-muted.mb-0 Date
                                        p.mb-0= new Date(booking.booking_date).toLocaleDateString()
                                    .col-6
                                        p.small.text-muted.mb-0 Time
                                        p.mb-0= booking.booking_time
                                
                                if booking.note
                                    .mb-3.p-2.bg-light.rounded
                                        small.text-muted.d-block Note:
                                        p.mb-0.small= booking.note

                                .d-flex.justify-content-between.align-items-center.pt-3.border-top.mb-3
                                    span.h5.mb-0.text-primary Total: $#{booking.total_cost}
                                    div
                                        a.btn.btn-sm.btn-outline-secondary.me-2(href=`/bookings/${booking.id}/details`) Details
                                        if booking.status === 'Confirmed'
                                            a.btn.btn-sm.btn-success(href=`/bookings/${booking.id}/payment`) Pay Now

                                // Task 1: Add a note to this booking
                                .mt-3.pt-3.border-top
                                    h6.small.fw-bold Add a note about this booking
                                    form(action='/bookings/add-note', method='POST')
                                        input(type='hidden' name='id' value=booking.id)
                                        textarea.form-control.form-control-sm(name='note' rows=3 placeholder='Enter progress or notes...')
                                        .d-grid.mt-2
                                            input.btn.btn-sm.btn-primary(type='submit' value='Submit Note')
        else
            .text-center.py-5
                .mb-4
                    span.fs-1 📅
                h2 No Bookings Found
                p You haven't booked any services yet.
                a.btn.btn-primary.mt-3(href="/services") Explore Services
