extends layouts/main.pug

block content
    .hero-section.text-center.py-5.mb-5
        .container
            h1.display-4.fw-bold.mb-3 My Bookings
            p.lead.text-white-50 Track and manage your service requests

    .container.pb-5
        if message
            .alert.alert-success.alert-dismissible.fade.show(role="alert")
                i.fas.fa-check-circle.me-2
                = message
                button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Close")

        if bookings && bookings.length > 0
            .row.g-4
                each booking in bookings
                    .col-md-6.col-lg-4
                        .card.shadow-sm.border-0.h-100
                            .card-header.bg-white.py-3.d-flex.justify-content-between.align-items-center
                                span.small.text-muted ID: ##{booking.id}
                                - var statusClass = 'bg-warning'
                                if booking.status === 'Confirmed'
                                    - statusClass = 'bg-info'
                                if booking.status === 'Completed'
                                    - statusClass = 'bg-success'
                                if booking.status === 'Cancelled'
                                    - statusClass = 'bg-danger'
                                span.badge.rounded-pill(class=statusClass)= booking.status
                            
                            .card-body.p-4
                                h5.fw-bold.mb-1= booking.service_name
                                p.text-muted.small.mb-4
                                    i.fas.fa-user-tie.me-2
                                    | Provider: #{booking.partner_name}
                                
                                .row.g-3.mb-4
                                    .col-6
                                        div.p-2.bg-light.rounded-3
                                            small.text-muted.d-block Date
                                            span.fw-bold.small= new Date(booking.booking_date).toLocaleDateString()
                                    .col-6
                                        div.p-2.bg-light.rounded-3
                                            small.text-muted.d-block Time
                                            span.fw-bold.small= booking.booking_time
                                
                                if booking.note
                                    .mb-4
                                        small.text-muted.fw-bold Note:
                                        p.mb-0.small.text-truncate= booking.note

                                .d-flex.justify-content-between.align-items-center.mb-4
                                    span.text-muted Total
                                    span.h4.mb-0.text-primary.fw-bold $#{booking.total_cost}

                                .d-grid.gap-2
                                    if booking.status === 'Pending' || booking.status === 'Confirmed'
                                        form(action=`/bookings/${booking.id}/cancel` method="POST" onsubmit="return confirm('Are you sure you want to cancel this booking?')")
                                            button.btn.btn-outline-danger.w-100(type="submit")
                                                i.fas.fa-times.me-2
                                                | Cancel Booking
                                    
                                    if booking.status === 'Confirmed'
                                        a.btn.btn-success(href=`/bookings/${booking.id}/payment`)
                                            i.fas.fa-credit-card.me-2
                                            | Pay Now
                                    
                                    if booking.status === 'Completed'
                                        //- Check if already reviewed (This would need a check in the controller, but for now we show button)
                                        a.btn.btn-primary(href=`/feedback/${booking.id}`)
                                            i.fas.fa-star.me-2
                                            | Rate & Review
                                    
                                    a.btn.btn-light(href=`/bookings/${booking.id}/details`)
                                        i.fas.fa-info-circle.me-2
                                        | View Details
        else
            .text-center.py-5
                .feature-icon.mx-auto.mb-4
                    i.fas.fa-calendar-times
                h3 No Bookings Found
                p.text-muted You haven't made any service requests yet.
                a.btn.btn-primary.mt-3(href="/services") Book Your First Service
