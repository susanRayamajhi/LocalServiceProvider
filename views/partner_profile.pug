extends layouts/main.pug

block content
    .row.mt-5
        .col-md-3
            .list-group.shadow-sm
                a.list-group-item.list-group-item-action(href="/partner/dashboard") Overview
                a.list-group-item.list-group-item-action(href="/partner/bookings") My Bookings
                a.list-group-item.list-group-item-action(href="/partner/availability") Manage Availability
                a.list-group-item.list-group-item-action(href="/partner/earnings") Earnings & Payouts
                a.list-group-item.list-group-item-action.active(href="/partner/profile") Edit Profile
        
        .col-md-9
            h2 Edit Profile
            p.text-muted Keep your profile updated to attract more customers.

            .card.mt-4.shadow-sm
                .card-body
                    form(action="/partner/profile" method="POST" enctype="multipart/form-data")
                        .row
                            .col-md-6.mb-3
                                label.form-label Name
                                input.form-control(type="text" name="name" value=partner.name)
                            .col-md-6.mb-3
                                label.form-label Email
                                input.form-control(type="email" name="email" value=partner.email disabled)
                        
                        .mb-3
                            label.form-label Business Description
                            textarea.form-control(name="description" rows="4")= partner.description
                        
                        .row
                            .col-md-6.mb-3
                                label.form-label Service Category
                                select.form-select(name="service_id")
                                    each service in allServices
                                        option(value=service.id selected=(service.id == partner.service_id))= service.name
                            .col-md-6.mb-3
                                label.form-label Base Rate ($/hr)
                                input.form-control(type="number" name="pricing" value=partner.pricing)
                        
                        .mb-3
                            label.form-label Portfolio Images
                            input.form-control(type="file" name="portfolio" multiple)
                        
                        hr
                        button.btn.btn-primary(type="submit") Update Profile
