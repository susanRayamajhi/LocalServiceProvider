extends layouts/main.pug

block content
    .row.mt-5
        .col-md-3
            .list-group.shadow-sm
                a.list-group-item.list-group-item-action.active(href="/admin/dashboard") Dashboard
                a.list-group-item.list-group-item-action(href="/admin/partners") Manage Partners
                a.list-group-item.list-group-item-action(href="/admin/users") Manage Users
                a.list-group-item.list-group-item-action(href="/admin/services") Manage Services
                a.list-group-item.list-group-item-action(href="/admin/bookings") All Bookings
                a.list-group-item.list-group-item-action(href="/admin/disputes") Disputes
                a.list-group-item.list-group-item-action(href="/admin/payments") Payments
        
        .col-md-9
            h2 Admin Command Center
            p Platform statistics from the actual database.

            .row.mt-4
                .col-md-3
                    .card.bg-dark.text-white.text-center.mb-3
                        .card-body
                            h5 Users
                            h2 #{stats.users}
                .col-md-3
                    .card.bg-primary.text-white.text-center.mb-3
                        .card-body
                            h5 Partners
                            h2 #{stats.partners}
                .col-md-3
                    .card.bg-success.text-white.text-center.mb-3
                        .card-body
                            h5 Bookings
                            h2 #{stats.bookings}
                .col-md-3
                    .card.bg-danger.text-white.text-center.mb-3
                        .card-body
                            h5 Disputes
                            h2 #{stats.disputes}
            
            .row.mt-4
                .col-md-12
                    .card.shadow-sm
                        .card-header.bg-warning.text-white
                            h5.mb-0 Pending Partner Approvals (User Story 21)
                        .card-body
                            table.table
                                thead
                                    tr
                                        th Name
                                        th Service
                                        th Joined Date
                                        th Actions
                                tbody
                                    each p in pendingPartners
                                        tr
                                            td= p.name
                                            td= p.service_name
                                            td= new Date(p.created_at).toLocaleDateString()
                                            td 
                                                form(action=`/api/admin/partners/${p.id}/approve` method="POST" style="display:inline")
                                                    button.btn.btn-sm.btn-success.me-2(type="submit") Approve
                                                form(action=`/api/admin/partners/${p.id}/reject` method="POST" style="display:inline")
                                                    button.btn.btn-sm.btn-danger(type="submit") Reject
                                    else
                                        tr
                                            td.text-center(colspan="4") No pending approvals.
