extends layouts/main.pug

block content
    .container.mt-5
        h2.mb-4 Chat History
        .card.shadow-sm
            .card-header.bg-dark.text-white
                | Conversation for Booking ##{bookingId}
            .card-body.bg-light(id="chat-box" style="height: 400px; overflow-y: auto;")
                each msg in messages
                    - var isMe = (msg.sender_type === role)
                    .mb-3.p-3.rounded(style=`max-width: 70%; ${isMe ? 'margin-left: auto; background-color: #007bff; color: white;' : 'background-color: #e9ecef; color: black;'}`)
                        strong= isMe ? 'Me' : (msg.sender_type === 'partner' ? msg.partner_name : 'Customer')
                        p.mb-1= msg.message
                        small(style="font-size: 0.75rem;")= new Date(msg.created_at).toLocaleTimeString()
                else
                    p.text-center.text-muted No messages yet.
            .card-footer
                form.d-flex(action=`/chat/${bookingId}/send` method="POST")
                    input.form-control.me-2(type="text" name="message" placeholder="Type a message..." required)
                    button.btn.btn-primary(type="submit") Send
        script.
            var chatBox = document.getElementById('chat-box');
            chatBox.scrollTop = chatBox.scrollHeight;
