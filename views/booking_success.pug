extends layouts/main.pug

block content
    .row.justify-content-center.mt-5
        .col-md-8.text-center
            .card.shadow-sm.p-5
                .mb-4
                    i.fa-solid.fa-circle-check.text-success.display-1
                h2 Booking Successful!
                p.lead Your service request has been processed.
                
                .card.bg-light.mt-4.mb-4
                    .card-body
                        h5.card-title Booking Details
                        .row
                            .col-6.text-end.fw-bold ID:
                            .col-6.text-start ##{booking.id}
                            .col-6.text-end.fw-bold Service:
                            .col-6.text-start #{booking.service_name}
                            .col-6.text-end.fw-bold Partner:
                            .col-6.text-start #{booking.partner_name}
                            .col-6.text-end.fw-bold Total Cost:
                            .col-6.text-start $#{booking.total_cost}
                            .col-6.text-end.fw-bold Status:
                            .col-6.text-start
                                span.badge.bg-info.text-dark= booking.status
                
                .d-flex.justify-content-center.gap-3
                    a.btn.btn-primary(href="/bookings") View My Bookings
                    a.btn.btn-outline-primary(href="/") Back to Home
