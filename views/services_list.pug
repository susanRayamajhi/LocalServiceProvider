extends layouts/main.pug

block content
    .hero-section.text-center.py-5.mb-5
        .container
            h1.display-4.fw-bold.mb-3 Our Services
            p.lead.text-white-50 Find the perfect expert for your home needs

    .container.pb-5
        .row.mb-5
            .col-lg-12
                .card.shadow-sm.p-4.border-0
                    form(action="/services" method="GET")
                        .row.g-3
                            .col-md-4
                                label.form-label.fw-bold Search Keywords
                                .input-group
                                    span.input-group-text.bg-white: i.fas.fa-search.text-muted
                                    input.form-control(type="text" name="search" placeholder="e.g. Plumbing, Cleaning..." value=query.search)
                            
                            .col-md-3
                                label.form-label.fw-bold Category
                                select.form-select(name="category")
                                    option(value="") All Categories
                                    if categories
                                        each cat in categories
                                            option(value=cat.id selected=(query.category == cat.id))= cat.name
                            
                            .col-md-3
                                label.form-label.fw-bold Price Range
                                .input-group
                                    input.form-control(type="number" name="minPrice" placeholder="Min" value=query.minPrice)
                                    span.input-group-text -
                                    input.form-control(type="number" name="maxPrice" placeholder="Max" value=query.maxPrice)
                            
                            .col-md-2.d-flex.align-items-end
                                button.btn.btn-primary.w-100(type="submit")
                                    i.fas.fa-filter.me-2
                                    | Filter

        if services && services.length > 0
            .row.g-4
                each service in services
                    .col-md-4
                        .card.h-100
                            .position-relative
                                img.card-img-top(src=service.image || "https://images.unsplash.com/photo-1581578731548-c64695cc6958?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt=service.name)
                                .position-absolute.top-0.end-0.m-3
                                    span.badge.bg-white.text-primary.shadow-sm.px-3.py-2.rounded-pill $#{service.base_price}
                            .card-body.p-4
                                .mb-2
                                    span.badge.bg-primary-subtle.text-primary.rounded-pill.small= service.category_name
                                h4.card-title.h5.mb-3= service.name
                                p.card-text.text-muted.small.mb-4= service.description
                                .d-grid
                                    a.btn.btn-outline-primary(href=`/services/${service.id}`) 
                                        i.fas.fa-info-circle.me-2
                                        | View Details & Book
        else
            .text-center.py-5
                .feature-icon.mx-auto.mb-4
                    i.fas.fa-search
                h3 No services match your criteria.
                p.text-muted Try adjusting your filters or keywords.
                a.btn.btn-primary.mt-3(href="/services") Clear All Filters
