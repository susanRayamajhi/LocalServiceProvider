extends layouts/main.pug

block content
    .container.py-5
        h1.display-4.mb-5 Our Services
        
        .row
            each service in services
                .col-md-4.mb-4
                    .card.h-100.shadow-sm.border-0
                        img.card-img-top(src=`/images/${service.image || 'default-service.png'}` alt=service.name style="height: 200px; object-fit: cover;")
                        .card-body
                            h5.card-title= service.name
                            p.card-text.text-muted= service.description
                            .d-flex.justify-content-between.align-items-center.mt-4.pt-3.border-top
                                span.h5.mb-0.text-primary $#{service.base_price}
                                a.btn.btn-primary(href=`/services/${service.id}`) View Details
        
        if services.length === 0
            .text-center.py-5
                h3 No services available at the moment.
                p Please check back later.
