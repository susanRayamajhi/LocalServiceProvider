extends layouts/main.pug

block content
    .container.py-5.text-center
        .row.justify-content-center
            .col-md-6
                .card.shadow-sm.border-0.p-5
                    h1.display-1.text-danger= status || 500
                    h2.fw-bold= title || "Something went wrong"
                    p.text-muted.mb-4= error || "An unexpected error occurred. Please try again later."
                    a.btn.btn-primary(href="/") Go Back Home
