extends ../layouts/main.pug

block content
    .row.mt-5
        .col-md-3
            .list-group.shadow-sm
                a.list-group-item.list-group-item-action(href="/admin/dashboard") Dashboard
                a.list-group-item.list-group-item-action.active(href="/admin/partners") Manage Partners
                a.list-group-item.list-group-item-action(href="/admin/users") Manage Users
                a.list-group-item.list-group-item-action(href="/admin/services") Manage Services
                a.list-group-item.list-group-item-action(href="/admin/bookings") All Bookings
                a.list-group-item.list-group-item-action(href="/admin/disputes") Disputes
                a.list-group-item.list-group-item-action(href="/admin/payments") Payments
        
        .col-md-9
            .d-flex.justify-content-between.align-items-center
                h2 Manage Partners
            
            .card.mt-4.shadow-sm
                .card-body
                    table.table.table-hover
                        thead
                            tr
                                th Name
                                th Email
                                th Joined Date
                                th Status
                                th Actions
                        tbody
                            each partner in partners
                                tr
                                    td= partner.name
                                    td= partner.email
                                    td= new Date(partner.created_at).toLocaleDateString()
                                    td
                                        span.badge(class=`bg-${partner.is_approved ? 'success' : 'warning'}`)= partner.is_approved ? 'Approved' : 'Pending'
                                        if partner.is_suspended
                                            span.badge.bg-danger.ms-2 Suspended
                                    td
                                        if !partner.is_approved
                                            form(action=`/api/admin/partners/${partner.id}/approve` method="POST" style="display:inline")
                                                button.btn.btn-sm.btn-success.me-2(type="submit") Approve
                                        form(action=`/api/admin/partners/${partner.id}/toggle-suspend` method="POST" style="display:inline")
                                            button.btn.btn-sm.me-2(class=`btn-outline-${partner.is_suspended ? 'success' : 'danger'}` type="submit")= partner.is_suspended ? 'Unsuspend' : 'Suspend'
                                        form(action=`/api/admin/partners/${partner.id}/reject` method="POST" style="display:inline")
                                            button.btn.btn-sm.btn-outline-danger(type="submit") Delete
                            else
                                tr
                                    td.text-center(colspan="5") No partners found.
