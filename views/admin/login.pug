extends ../layouts/main.pug

block content
    .container.py-5
        .row.justify-content-center
            .col-md-5
                .card.shadow-lg.p-4.border-0
                    .text-center.mb-4
                        .feature-icon.mx-auto.bg-dark.text-white
                            i.fas.fa-user-shield
                        h2.fw-bold Admin Login
                        p.text-muted Access the system command center
                    
                    if error
                        .alert.alert-danger.alert-dismissible.fade.show(role="alert")
                            i.fas.fa-exclamation-circle.me-2
                            = error
                            button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Close")
                    
                    form(action="/api/admin/login" method="POST")
                        .mb-3
                            label.form-label.fw-bold(for="email") Admin Email
                            .input-group
                                span.input-group-text.bg-white: i.fas.fa-envelope.text-muted
                                input#email.form-control(type="email" name="email" placeholder="admin@lsp.com" required)
                        .mb-4
                            label.form-label.fw-bold(for="password") Password
                            .input-group
                                span.input-group-text.bg-white: i.fas.fa-key.text-muted
                                input#password.form-control(type="password" name="password" placeholder="••••••••" required)
                        
                        .d-grid
                            button.btn.btn-dark.btn-lg(type="submit")
                                i.fas.fa-lock.me-2
                                | Sign In to Admin Panel
