extends ../layouts/main.pug

block content
    .row.mt-5
        .col-md-3
            .list-group.shadow-sm
                a.list-group-item.list-group-item-action(href="/admin/dashboard") Dashboard
                a.list-group-item.list-group-item-action(href="/admin/partners") Manage Partners
                a.list-group-item.list-group-item-action(href="/admin/users") Manage Users
                a.list-group-item.list-group-item-action(href="/admin/services") Manage Services
                a.list-group-item.list-group-item-action(href="/admin/bookings") All Bookings
                a.list-group-item.list-group-item-action(href="/admin/disputes") Disputes
                a.list-group-item.list-group-item-action(href="/admin/payments") Payments
                a.list-group-item.list-group-item-action.active(href="/admin/reports") Generate Reports
        
        .col-md-9
            h2 Generate Reports
            p.text-muted Analyze platform performance.

            .card.mt-4.shadow-sm
                .card-body
                    form(action="/admin/reports" method="POST")
                        .row.mb-3
                            .col-md-4
                                label.form-label Report Type
                                select.form-select(name="reportType")
                                    option(value="bookings") Bookings Report
                                    option(value="revenue") Revenue Report
                                    option(value="partners") Partner Performance
                                    option(value="users") User Growth
                            .col-md-4
                                label.form-label Start Date
                                input.form-control(type="date" name="startDate")
                            .col-md-4
                                label.form-label End Date
                                input.form-control(type="date" name="endDate")
                        
                        button.btn.btn-primary(type="submit") Generate & Download Report
            
            .card.mt-4.shadow-sm
                .card-header.bg-white
                    h5.mb-0 Recently Generated
                .card-body
                    table.table.table-sm
                        thead
                            tr
                                th Name
                                th Date
                                th Type
                                th Action
                        tbody
                            tr
                                td Bookings_March_2026.pdf
                                td 28-03-2026
                                td PDF
                                td
                                    button.btn.btn-sm.btn-outline-primary Download
                        else
                            tr
                                td.text-center(colspan="4") No reports generated yet.
