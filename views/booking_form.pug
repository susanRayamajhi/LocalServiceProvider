extends layouts/main.pug

block content
    .hero-section.text-center.py-5.mb-5
        .container
            h1.display-4.fw-bold.mb-3 Book Your Service
            p.lead.text-white-50 Review your choice and pick a time slot

    .container.pb-5
        .row.justify-content-center
            .col-lg-8
                .card.shadow-lg.border-0
                    .card-body.p-5
                        .d-flex.align-items-center.mb-5
                            .feature-icon.m-0.me-4.bg-primary-subtle.text-primary
                                i.fas.fa-calendar-check
                            div
                                h2.h4.fw-bold.mb-1= service.name
                                p.text-muted.small.mb-0 Fixed Price: $#{service.base_price}
                        
                        form(action="/bookings/create" method="POST")
                            input(type="hidden" name="service_id" value=service.id)
                            input(type="hidden" name="total_cost" value=service.base_price)
                            
                            .row.g-4
                                .col-md-12
                                    label.form-label.fw-bold Choose Your Professional
                                    .input-group
                                        span.input-group-text.bg-white: i.fas.fa-user-tie.text-muted
                                        select.form-select(name="partner_id" required)
                                            option(value="") Select a verified partner...
                                            if providers
                                                each provider in providers
                                                    option(value=provider.id selected=(provider.id == selectedPartnerId))= `${provider.name} (${provider.rating || '0.0'} ⭐)`
                                
                                .col-md-6
                                    label.form-label.fw-bold Service Date
                                    .input-group
                                        span.input-group-text.bg-white: i.fas.fa-calendar-day.text-muted
                                        input.form-control(type="date" name="booking_date" required min=new Date().toISOString().split('T')[0])
                                
                                .col-md-6
                                    label.form-label.fw-bold Preferred Time
                                    .input-group
                                        span.input-group-text.bg-white: i.fas.fa-clock.text-muted
                                        input.form-control(type="time" name="booking_time" required)
                                
                                .col-md-12
                                    label.form-label.fw-bold Special Instructions (Optional)
                                    textarea.form-control(name="note" rows="3" placeholder="Tell us more about the job or any specific requirements...")
                            
                            hr.my-5
                            
                            .d-flex.justify-content-between.align-items-center.mb-4
                                div
                                    h6.mb-0 Total Amount
                                    small.text-muted (Include all taxes)
                                h3.text-primary.fw-bold $#{service.base_price}
                            
                            .d-grid
                                button.btn.btn-primary.btn-lg(type="submit")
                                    i.fas.fa-check-circle.me-2
                                    | Confirm & Schedule Booking
                    
                    .card-footer.bg-light.text-center.py-3.border-0
                        p.small.text-muted.mb-0 
                            i.fas.fa-info-circle.me-1
                            | You can pay online or after the service is completed.
