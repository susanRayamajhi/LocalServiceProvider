extends layouts/main.pug

block content
    .row.justify-content-center.mt-5
        .col-md-6
            .card.shadow-sm
                .card-header.bg-primary.text-white
                    h3.mb-0 Book Service
                .card-body.p-4
                    h5 Service: #{service.name}
                    p.text-muted Base Price: $#{service.base_price}
                    hr
                    form(action="/bookings/create" method="POST")
                        input(type="hidden" name="service_id" value=service.id)
                        input(type="hidden" name="total_cost" value=service.base_price)
                        
                        .mb-3
                            label.form-label Select Provider
                            select.form-select(name="partner_id" required)
                                option(value="") Choose a professional...
                                each provider in providers
                                    option(value=provider.id selected=(provider.id == selectedPartnerId))= `${provider.name} (${provider.rating} ⭐)`
                        
                        .mb-3
                            label.form-label Preferred Date
                            input.form-control(type="date" name="booking_date" required)
                        
                        .mb-3
                            label.form-label Preferred Time
                            input.form-control(type="time" name="booking_time" required)
                        
                        .mb-4
                            label.form-label Special Instructions
                            textarea.form-control(name="note" rows="2" placeholder="Any specific requirements?")
                        
                        .d-grid
                            button.btn.btn-primary.btn-lg(type="submit") Confirm Booking
