extends layouts/main.pug

block content
    .container.py-5
        .row.justify-content-center
            .col-md-6
                .card.shadow-lg.border-0.overflow-hidden
                    .card-body.p-0
                        .bg-success.text-white.text-center.p-4
                            .feature-icon.mx-auto.bg-white.text-success.mb-3
                                i.fas.fa-check
                            h2.fw-bold Payment Successful!
                            p.mb-0.opacity-75 Your booking is now confirmed.
                        
                        .p-5
                            .d-flex.justify-content-between.mb-4
                                div
                                    h6.text-muted.text-uppercase.small.ls-1 Receipt No.
                                    p.fw-bold.mb-0 LSP-REC-#{booking.id}-#{Date.now().toString().slice(-4)}
                                div.text-end
                                    h6.text-muted.text-uppercase.small.ls-1 Date
                                    p.fw-bold.mb-0= new Date().toLocaleDateString()
                            
                            hr.my-4
                            
                            .mb-4
                                h6.text-muted.text-uppercase.small.ls-1 Service Details
                                .d-flex.justify-content-between.align-items-center.mt-2
                                    span.fw-bold= booking.service_name
                                    span $#{booking.total_cost}
                                p.text-muted.small.mb-0 Provider: #{booking.partner_name}
                            
                            .mb-4.p-3.bg-light.rounded-3
                                .d-flex.justify-content-between.align-items-center
                                    span.fw-bold Total Paid
                                    span.h4.mb-0.text-success.fw-bold $#{booking.total_cost}
                            
                            .d-grid.gap-2
                                button.btn.btn-outline-primary(onclick="window.print()")
                                    i.fas.fa-print.me-2
                                    | Print Receipt
                                a.btn.btn-primary(href="/bookings")
                                    i.fas.fa-tasks.me-2
                                    | Back to My Bookings
                    
                    .card-footer.bg-light.text-center.py-3.border-0
                        p.small.text-muted.mb-0 A copy of this receipt has been sent to your email.
