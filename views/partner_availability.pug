extends layouts/main.pug

block content
    .row.mt-5
        .col-md-3
            .list-group.shadow-sm
                a.list-group-item.list-group-item-action(href="/partner/dashboard") Overview
                a.list-group-item.list-group-item-action(href="/partner/bookings") My Bookings
                a.list-group-item.list-group-item-action.active(href="/partner/availability") Manage Availability
                a.list-group-item.list-group-item-action(href="/partner/earnings") Earnings & Payouts
                a.list-group-item.list-group-item-action(href="/partner/profile") Edit Profile
        
        .col-md-9
            h2 Manage Availability
            p.text-muted Set your working hours and days.

            if message
                .alert.alert-success= message

            .card.mt-4.shadow-sm
                .card-body
                    form(action="/partner/availability" method="POST")
                        .row
                            each day in ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']
                                .col-md-6.mb-3
                                    .form-check.form-switch
                                        input.form-check-input(type="checkbox" id=day name="days[]" value=day)
                                        label.form-check-label(for=day)= day
                                    .row.mt-2
                                        .col
                                            input.form-control.form-control-sm(type="time" name=`start_${day}` placeholder="Start")
                                        .col
                                            input.form-control.form-control-sm(type="time" name=`end_${day}` placeholder="End")
                        
                        hr
                        button.btn.btn-primary(type="submit") Save Availability
