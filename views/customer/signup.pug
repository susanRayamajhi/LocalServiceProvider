extends ../layouts/main.pug

block content
    .container.py-5
        .row.justify-content-center
            .col-md-6
                .card.shadow-lg.p-4.border-0
                    .text-center.mb-4
                        .feature-icon.mx-auto.bg-primary-subtle.text-primary
                            i.fas.fa-user-plus
                        h2.fw-bold Create Account
                        p.text-muted Join us to book local experts easily
                    
                    form(action="/api/auth/signup" method="POST")
                        .mb-3
                            label.form-label.fw-bold Full Name
                            input.form-control(type="text" name="name" placeholder="John Doe" required)
                        
                        .mb-3
                            label.form-label.fw-bold Email Address
                            input.form-control(type="email" name="email" placeholder="john@example.com" required)
                        
                        .mb-3
                            label.form-label.fw-bold Phone Number
                            input.form-control(type="tel" name="phone" placeholder="+1 234 567 890")
                        
                        .mb-4
                            label.form-label.fw-bold Password
                            input.form-control(type="password" name="password" placeholder="••••••••" required)
                        
                        .d-grid
                            button.btn.btn-primary.btn-lg(type="submit")
                                i.fas.fa-user-check.me-2
                                | Register Now
                    
                    .text-center.mt-4
                        p.mb-0 Already have an account? 
                            a.text-primary.fw-bold(href="/customer/login") Login here
