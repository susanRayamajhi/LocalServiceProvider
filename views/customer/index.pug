extends ../layouts/main.pug

block content
    section.hero-section.text-center
        .container
            .row.justify-content-center
                .col-lg-8
                    h1.display-3.fw-bold.mb-4 Reliable Experts, Ready to Help.
                    p.lead.mb-5 Book professional home services from verified local providers in just a few clicks.
                    .d-flex.justify-content-center.gap-3
                        a.btn.btn-light.btn-lg.px-5(href="/services") Book a Service

    .container.my-5
        .row.g-4.text-center
            .col-md-4
                .card.p-4.h-100
                    .feature-icon
                        i.fas.fa-shield-check
                    h4.h5.mb-3 Verified Partners
                    p.text-muted Every provider is strictly vetted and background-checked for your peace of mind.
            .col-md-4
                .card.p-4.h-100
                    .feature-icon
                        i.fas.fa-clock
                    h4.h5.mb-3 Instant Booking
                    p.text-muted Schedule your service at a time that works for you with real-time availability.
            .col-md-4
                .card.p-4.h-100
                    .feature-icon
                        i.fas.fa-credit-card
                    h4.h5.mb-3 Secure Payments
                    p.text-muted Hassle-free online payments with transparent pricing and no hidden costs.

    section.popular-services.py-5
        .container
            .d-flex.justify-content-between.align-items-end.mb-5
                div
                    h2.mb-0 Popular Services
                    p.text-muted High-quality services rated by users
                a.btn.btn-outline-primary(href="/services") View All
            
            .row.g-4
                if services && services.length > 0
                    each service in services
                        .col-md-4
                            .card.h-100
                                img.card-img-top(src=service.image || "https://images.unsplash.com/photo-1581578731548-c64695cc6958?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt=service.name)
                                .card-body
                                    .mb-2
                                        span.badge.bg-primary-subtle.text-primary.rounded-pill.px-3 Popular
                                    h5.card-title.mb-3= service.name
                                    p.card-text.text-muted.small.mb-4= service.description
                                    .d-flex.justify-content-between.align-items-center
                                        span.fw-bold.fs-5 Starts at $#{service.base_price}
                                        a.btn.btn-primary.btn-sm(href=`/services/${service.id}`) Book Now
                else
                    .col-12.text-center
                        p.text-muted No services available at the moment.

    section.how-it-works.py-5.bg-white.rounded-5.my-5.shadow-sm
        .container
            h2.text-center.mb-5 How It Works
            .row.g-4
                .col-md-3.text-center
                    .mb-4
                        span.badge.bg-primary.rounded-pill.px-3.py-2.fs-5 01
                    h5 Select a Service
                    p.text-muted Browse from various home service categories.
                .col-md-3.text-center
                    .mb-4
                        span.badge.bg-primary.rounded-pill.px-3.py-2.fs-5 02
                    h5 Choose Professional
                    p.text-muted Compare partners by rating and experience.
                .col-md-3.text-center
                    .mb-4
                        span.badge.bg-primary.rounded-pill.px-3.py-2.fs-5 03
                    h5 Pick Date & Time
                    p.text-muted Select a slot that fits your schedule perfectly.
                .col-md-3.text-center
                    .mb-4
                        span.badge.bg-primary.rounded-pill.px-3.py-2.fs-5 04
                    h5 Enjoy the Service
                    p.text-muted Relax while our vetted expert does the job.
