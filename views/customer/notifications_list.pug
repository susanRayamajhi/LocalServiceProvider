extends ../layouts/main.pug

block content
    .container.mt-5
        h2.mb-4 Notifications Center
        .row
            each n in notifications
                .col-12.mb-3
                    .card.shadow-sm(style=`border-left: 5px solid ${n.type === "success" ? "#28a745" : n.type === "warning" ? "#ffc107" : "#007bff"};`)
                        .card-body.d-flex.justify-content-between.align-items-center
                            div
                                h5.card-title= n.title
                                p.card-text= n.message
                                small.text-muted= new Date(n.created_at).toLocaleString()
                            if !n.is_read
                                form(action=`/notifications/read/${n.id}`, method="POST")
                                    button.btn.btn-outline-secondary.btn-sm Mark Read
                            else
                                span.badge.bg-secondary Read
