extends layouts/main.pug

block content
    .row.mt-5
        .col-md-3
            .list-group.shadow-sm
                a.list-group-item.list-group-item-action(href="/admin/dashboard") Dashboard
                a.list-group-item.list-group-item-action(href="/admin/partners") Manage Partners
                a.list-group-item.list-group-item-action(href="/admin/users") Manage Users
                a.list-group-item.list-group-item-action.active(href="/admin/services") Manage Services
                a.list-group-item.list-group-item-action(href="/admin/bookings") All Bookings
                a.list-group-item.list-group-item-action(href="/admin/disputes") Disputes
                a.list-group-item.list-group-item-action(href="/admin/payments") Payments
        
        .col-md-9
            .d-flex.justify-content-between.align-items-center
                h2 Manage Services
                button.btn.btn-primary Add New Category

            .card.mt-4.shadow-sm
                .card-body
                    .row
                        each service in services
                            .col-md-4.mb-4
                                .card.h-100.shadow-sm
                                    .card-body
                                        h5.card-title= service.name
                                        p.card-text.text-muted= service.description
                                        .d-flex.justify-content-between.mt-3
                                            button.btn.btn-sm.btn-outline-primary Edit
                                            button.btn.btn-sm.btn-outline-danger Delete
                        else
                            .col-12.text-center
                                p No services found.
