extends layouts/main.pug

block content
    .row.mt-5
        .col-md-3
            .list-group.shadow-sm
                a.list-group-item.list-group-item-action(href="/admin/dashboard") Dashboard
                a.list-group-item.list-group-item-action(href="/admin/partners") Manage Partners
                a.list-group-item.list-group-item-action(href="/admin/users") Manage Users
                a.list-group-item.list-group-item-action.active(href="/admin/services") Manage Services
                a.list-group-item.list-group-item-action(href="/admin/bookings") All Bookings
                a.list-group-item.list-group-item-action(href="/admin/disputes") Disputes
                a.list-group-item.list-group-item-action(href="/admin/payments") Payments
        
        .col-md-9
            .d-flex.justify-content-between.align-items-center
                h2 Manage Services & Categories
            
            .card.mt-4.shadow-sm
                .card-header.bg-primary.text-white
                    h5.mb-0 Manage Categories (User Story 23)
                .card-body
                    form(action="/api/admin/categories" method="POST")
                        .row
                            .col-md-4
                                input.form-control(type="text" name="name" placeholder="Category Name" required)
                            .col-md-6
                                input.form-control(type="text" name="description" placeholder="Description")
                            .col-md-2
                                button.btn.btn-success.w-100 Add
                    
                    hr
                    table.table.mt-3
                        thead
                            tr
                                th Name
                                th Description
                                th Actions
                        tbody
                            each cat in categories
                                tr
                                    td= cat.name
                                    td= cat.description
                                    td
                                        form(action=`/api/admin/categories/${cat.id}/delete` method="POST")
                                            button.btn.btn-sm.btn-danger(type="submit") Delete
                            else
                                tr
                                    td.text-center(colspan="3") No categories found.

            .card.mt-4.shadow-sm
                .card-header.bg-dark.text-white
                    h5.mb-0 All Services
                .card-body
                    .row
                        each service in services
                            .col-md-4.mb-4
                                .card.h-100.shadow-sm
                                    .card-body
                                        h5.card-title= service.name
                                        span.badge.bg-info.mb-2= service.category_name
                                        p.card-text.text-muted= service.description
                                        .d-flex.justify-content-between.mt-3
                                            button.btn.btn-sm.btn-outline-primary Edit
                                            button.btn.btn-sm.btn-outline-danger Delete
                        else
                            .col-12.text-center
                                p No services found.
