doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title #{title} | Local Service Provider
        link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css")
        link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
        style.
            body { padding-top: 80px; background-color: #f8f9fa; min-height: 100vh; display: flex; flex-direction: column; }
            .navbar { background-color: #343a40; }
            main { flex: 1; }
            footer { padding: 20px 0; background-color: #343a40; color: white; margin-top: 50px; }
    body
        include ../partials/header.pug
        
        main.container
            block content
            
        include ../partials/footer.pug
        script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")
