extends layouts/main.pug

block content
    .row.justify-content-center.mt-5
        .col-md-8
            .card.shadow-sm
                .card-header.bg-primary.text-white
                    h4.mb-0 Rate Your Experience
                .card-body
                    form(action="/feedback" method="POST")
                        input(type="hidden" name="bookingId" value=booking.id)
                        
                        .text-center.mb-4
                            h5 How was your service with #{partner.name}?
                            .rating-stars.fs-2
                                each star in [1, 2, 3, 4, 5]
                                    input.d-none(type="radio" name="rating" value=star id=`star${star}`)
                                    label.cursor-pointer(for=`star${star}`) ★
                        
                        .mb-3
                            label.form-label Your Review
                            textarea.form-control(name="comment" rows="4" placeholder="Share your experience...")
                        
                        .mb-3
                            label.form-label Would you recommend this partner?
                            .form-check
                                input.form-check-input(type="radio" name="recommend" value="yes" id="recYes")
                                label.form-check-label(for="recYes") Yes, definitely!
                            .form-check
                                input.form-check-input(type="radio" name="recommend" value="no" id="recNo")
                                label.form-check-label(for="recNo") No
                        
                        .d-grid
                            button.btn.btn-primary.btn-lg(type="submit") Submit Feedback
