extends ../layouts/main.pug

block content
    .row.mt-5
        .col-md-3
            .list-group.shadow-sm
                a.list-group-item.list-group-item-action(href="/partner/dashboard") Overview
                a.list-group-item.list-group-item-action(href="/partner/bookings") My Bookings
                a.list-group-item.list-group-item-action(href="/partner/availability") Manage Availability
                a.list-group-item.list-group-item-action(href="/partner/earnings") Earnings & Payouts
                a.list-group-item.list-group-item-action.active(href="/partner/profile") Edit Profile
        
        .col-md-9
            h2 Edit Profile
            p.text-muted Keep your profile updated to attract more customers.

            if message
                .alert.alert-success= message

            .card.mt-4.shadow-sm
                .card-body
                    h5.card-title Business Details
                    form(action="/partner/profile" method="POST")
                        .row
                            .col-md-6.mb-3
                                label.form-label Name
                                input.form-control(type="text" name="name" value=partner.name required)
                            .col-md-6.mb-3
                                label.form-label Email
                                input.form-control(type="email" name="email" value=partner.email disabled)
                        
                        .mb-3
                            label.form-label Business Description
                            textarea.form-control(name="description" rows="4")= partner.description
                        
                        .row
                            .col-md-6.mb-3
                                label.form-label Service Category
                                select.form-select(name="service_id")
                                    each service in allServices
                                        option(value=service.id selected=(service.id == partner.service_id))= service.name
                            .col-md-6.mb-3
                                label.form-label Base Rate ($/hr)
                                input.form-control(type="number" name="pricing" value=partner.pricing)
                        
                        button.btn.btn-primary(type="submit") Update Profile

            .card.mt-4.shadow-sm
                .card-body
                    h5.card-title Verification Documents (User Story 12)
                    p.text-muted Upload your ID or business license for verification.
                    
                    form(action="/partner/upload-document" method="POST" enctype="multipart/form-data")
                        .row
                            .col-md-6.mb-3
                                label.form-label Document Type
                                select.form-select(name="document_type")
                                    option(value="ID Card") ID Card
                                    option(value="Business License") Business License
                                    option(value="Tax ID") Tax ID
                            .col-md-6.mb-3
                                label.form-label Select File
                                input.form-control(type="file" name="document")
                        
                        button.btn.btn-outline-primary(type="submit") Upload Document
                    
                    if documents && documents.length > 0
                        hr
                        h6.mt-3 Uploaded Documents
                        ul.list-group
                            each doc in documents
                                li.list-group-item.d-flex.justify-content-between.align-items-center
                                    div
                                        strong= doc.document_type
                                        br
                                        small.text-muted Uploaded on: #{doc.uploaded_at.toDateString()}
                                    span.badge(class=`bg-${doc.status === 'Approved' ? 'success' : doc.status === 'Pending' ? 'warning' : 'danger'}`)= doc.status

