extends ../layouts/main.pug

block content
    .container.py-5
        .row.justify-content-center
            .col-lg-8
                .card.shadow-lg.border-0
                    .card-header.bg-success.text-white.text-center.py-4
                        h2.fw-bold Partner Registration
                        p.mb-0 Join our expert network and grow your business
                    
                    .card-body.p-4.p-md-5
                        form(action="/api/partners/signup" method="POST")
                            .row.g-3
                                .col-md-6
                                    label.form-label.fw-bold Full Name / Business Name
                                    input.form-control(type="text" name="name" placeholder="Expert Services Ltd" required)
                                
                                .col-md-6
                                    label.form-label.fw-bold Business Email
                                    input.form-control(type="email" name="email" placeholder="contact@business.com" required)
                                
                                .col-md-6
                                    label.form-label.fw-bold Phone Number
                                    input.form-control(type="tel" name="phone" placeholder="+1 234 567 890")
                                
                                .col-md-6
                                    label.form-label.fw-bold Password
                                    input.form-control(type="password" name="password" placeholder="••••••••" required)
                                
                                .col-md-6
                                    label.form-label.fw-bold Primary Service
                                    select.form-select(name="service_id" required)
                                        option(value="" disabled selected) Select your specialty
                                        each service in services
                                            option(value=service.id)= service.name
                                
                                .col-md-6
                                    label.form-label.fw-bold Years of Experience
                                    input.form-control(type="number" name="experience" placeholder="e.g. 5")
                                
                                .col-12
                                    label.form-label.fw-bold Business Description
                                    textarea.form-control(name="description" rows="3" placeholder="Tell customers about your skills and quality of work...")
                                
                                .col-md-6
                                    label.form-label.fw-bold Hourly Rate ($)
                                    input.form-control(type="number" name="pricing" placeholder="e.g. 50")
                                
                                .col-12.mt-4
                                    .d-grid
                                        button.btn.btn-success.btn-lg(type="submit")
                                            i.fas.fa-paper-plane.me-2
                                            | Submit My Application
                    
                    .card-footer.bg-light.text-center.py-3.border-0
                        p.mb-0 Already a partner? 
                            a.text-success.fw-bold(href="/partner/login") Sign In here
