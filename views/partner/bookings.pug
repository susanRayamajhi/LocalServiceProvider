extends ../layouts/main.pug

block content
    .row.mt-5
        .col-md-3
            .list-group.shadow-sm
                a.list-group-item.list-group-item-action(href="/partner/dashboard") Overview
                a.list-group-item.list-group-item-action.active(href="/partner/bookings") My Bookings
                a.list-group-item.list-group-item-action(href="/partner/availability") Manage Availability
                a.list-group-item.list-group-item-action(href="/partner/earnings") Earnings & Payouts
                a.list-group-item.list-group-item-action(href="/partner/profile") Edit Profile
        
        .col-md-9
            h2 My Bookings

            .card.mt-4.shadow-sm
                .card-body
                    table.table.table-hover
                        thead
                            tr
                                th ID
                                th Customer
                                th Service
                                th Status
                                th Actions
                        tbody
                            each booking in bookings
                                tr
                                    td ##{booking.id}
                                    td= booking.customer_name
                                    td= booking.service_name
                                    td
                                        span.badge(class=`bg-${booking.status === 'Completed' ? 'success' : booking.status === 'Pending' ? 'warning' : 'info'}`)= booking.status
                                    td
                                        if booking.status === 'Pending'
                                            form(action=`/api/partners/bookings/${booking.id}/accept` method="POST" style="display:inline")
                                                button.btn.btn-sm.btn-success.me-2(type="submit") Accept
                                            form(action=`/api/partners/bookings/${booking.id}/reject` method="POST" style="display:inline")
                                                button.btn.btn-sm.btn-danger.me-2(type="submit") Reject
                                        else if booking.status === 'Confirmed'
                                            form(action=`/api/partners/bookings/${booking.id}/status/Completed` method="POST" style="display:inline")
                                                button.btn.btn-sm.btn-primary.me-2(type="submit") Mark as Completed
                                        a.btn.btn-sm.btn-outline-primary(href=`/chat/${booking.id}`) Chat
                            else
                                tr
                                    td.text-center(colspan="5") No bookings found.
