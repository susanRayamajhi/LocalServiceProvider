extends layouts/main.pug

block content
    .row.mt-5
        .col-md-3
            .list-group.shadow-sm
                a.list-group-item.list-group-item-action(href="/partner/dashboard") Overview
                a.list-group-item.list-group-item-action(href="/partner/bookings") My Bookings
                a.list-group-item.list-group-item-action(href="/partner/availability") Manage Availability
                a.list-group-item.list-group-item-action.active(href="/partner/earnings") Earnings & Payouts
                a.list-group-item.list-group-item-action(href="/partner/profile") Edit Profile
        
        .col-md-9
            .d-flex.justify-content-between.align-items-center
                h2 Earnings & Payouts
                a.btn.btn-success(href="/partner/withdraw") Request Payout

            .row.mt-4
                .col-md-4
                    .card.bg-light.text-center.mb-3
                        .card-body
                            h5 Total Earned
                            h2 $#{stats.totalEarned}
                .col-md-4
                    .card.bg-light.text-center.mb-3
                        .card-body
                            h5 Withdrawn
                            h2 $#{stats.totalWithdrawn}
                .col-md-4
                    .card.bg-light.text-center.mb-3
                        .card-body
                            h5 Balance
                            h2.text-primary $#{stats.balance}

            .card.mt-4.shadow-sm
                .card-header.bg-white
                    h5.mb-0 Payout History
                .card-body
                    table.table.table-hover
                        thead
                            tr
                                th Date
                                th Amount
                                th Method
                                th Status
                        tbody
                            each payout in payouts
                                tr
                                    td= payout.date
                                    td $#{payout.amount}
                                    td= payout.method
                                    td
                                        span.badge.bg-success Completed
                            else
                                tr
                                    td.text-center(colspan="4") No payout history yet.
