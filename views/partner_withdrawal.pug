extends layouts/main

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-6
        .card.shadow
          .card-header.bg-primary.text-white
            h4 Partner Withdrawal Request
          .card-body
            form(action="/api/partners/withdraw" method="POST")
              .mb-3
                label(for="amount" class="form-label") Amount to Withdraw
                input(type="number" name="amount" id="amount" class="form-control" placeholder="Enter amount" required)
              .mb-3
                label(for="bank_details" class="form-label") Bank Account / UPI ID
                input(type="text" name="bank_details" id="bank_details" class="form-control" placeholder="Account Number, IFSC or UPI" required)
              .mb-3
                label(for="note" class="form-label") Note (Optional)
                textarea(name="note" id="note" class="form-control" rows="3")
              .d-grid
                button(type="submit" class="btn btn-success") Submit Request
          .card-footer.text-muted
            p.small * Withdrawal requests are processed within 3-5 business days.
