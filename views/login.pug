extends layouts/main.pug

block content
    .row.justify-content-center.mt-5
        .col-md-5
            .card.shadow-lg.border-0
                .card-header.bg-dark.text-white.text-center.p-4
                    h2.mb-0 Welcome Back
                    p.small.mb-0 Login to access your account
                .card-body.p-5
                    form(action="/login" method="POST")
                        .mb-4
                            label.form-label Email Address
                            input.form-control.form-control-lg(type="email" name="email" required placeholder="john@example.com")
                        .mb-4
                            label.form-label Password
                            input.form-control.form-control-lg(type="password" name="password" required placeholder="••••••••")
                        .d-flex.justify-content-between.mb-4
                            .form-check
                                input.form-check-input(type="checkbox" id="remember")
                                label.form-check-label(for="remember") Remember me
                            a.text-primary.small(href="/forgot-password") Forgot password?
                        .d-grid
                            button.btn.btn-primary.btn-lg(type="submit") Login
                    .text-center.mt-4
                        p.text-muted New here? 
                            a(href="/signup") Create an account
