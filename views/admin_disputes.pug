extends layouts/main.pug

block content
    .row.mt-5
        .col-md-3
            .list-group.shadow-sm
                a.list-group-item.list-group-item-action(href="/admin/dashboard") Dashboard
                a.list-group-item.list-group-item-action(href="/admin/partners") Manage Partners
                a.list-group-item.list-group-item-action(href="/admin/users") Manage Users
                a.list-group-item.list-group-item-action(href="/admin/services") Manage Services
                a.list-group-item.list-group-item-action(href="/admin/bookings") All Bookings
                a.list-group-item.list-group-item-action.active(href="/admin/disputes") Disputes
                a.list-group-item.list-group-item-action(href="/admin/payments") Payments
        
        .col-md-9
            h2 Dispute Resolution Center

            .card.mt-4.shadow-sm
                .card-body
                    table.table.table-hover
                        thead
                            tr
                                th Booking ID
                                th Raised By
                                th Reason
                                th Status
                                th Actions
                        tbody
                            each dispute in disputes
                                tr
                                    td ##{dispute.bookingId}
                                    td= dispute.raisedBy
                                    td= dispute.reason
                                    td
                                        span.badge.bg-danger Pending
                                    td
                                        button.btn.btn-sm.btn-outline-primary Resolve
                            else
                                tr
                                    td.text-center(colspan="5") No active disputes.
