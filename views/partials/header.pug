nav.navbar.navbar-expand-lg.navbar-dark.fixed-top
    .container
        a.navbar-brand(href="/") Local Service Provider
        button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav")
            span.navbar-toggler-icon
        #navbarNav.collapse.navbar-collapse
            ul.navbar-nav.ms-auto
                li.nav-item
                    a.nav-link(href="/services") Services
                li.nav-item
                    a.nav-link(href="/providers") Providers
                if user
                    if user.role === 'customer'
                        li.nav-item
                            a.nav-link(href="/bookings") My Bookings
                        li.nav-item
                            a.nav-link(href="/chat") Messages
                        li.nav-item
                            a.nav-link(href="/notifications") Notifications
                    li.nav-item.dropdown
                        a.nav-link.dropdown-toggle(href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false")
                            | Hi, #{user.name}
                        ul.dropdown-menu.dropdown-menu-end(aria-labelledby="navbarDropdown")
                            if user.role === 'partner'
                                li: a.dropdown-item(href="/partner/dashboard") Partner Dashboard
                            if user.role === 'admin'
                                li: a.dropdown-item(href="/admin/dashboard") Admin Dashboard
                            if user.role === 'customer'
                                li: a.dropdown-item(href="/profile") My Profile
                            li: hr.dropdown-divider
                            li: a.dropdown-item(href="/logout") Logout
                else
                    li.nav-item
                        a.nav-link(href="/login") Login
                    li.nav-item
                        a.nav-link(href="/signup") Signup
                    li.nav-item
                        a.nav-link.btn.btn-outline-light.ms-lg-3(href="/partner/signup") Become a Partner
