nav.navbar.navbar-expand-lg.fixed-top
    .container
        a.navbar-brand(href="/")
            i.fas.fa-tools.me-2
            | LSP
        button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav")
            span.navbar-toggler-icon
        #navbarNav.collapse.navbar-collapse
            ul.navbar-nav.mx-auto
                li.nav-item
                    a.nav-link(href="/services" class=(path === '/services' ? 'active' : ''))
                        i.fas.fa-th-large.me-1
                        | Services
                li.nav-item
                    a.nav-link(href="/providers" class=(path === '/providers' ? 'active' : ''))
                        i.fas.fa-user-tie.me-1
                        | Providers
                if user && user.role === 'customer'
                    li.nav-item
                        a.nav-link(href="/bookings" class=(path === '/bookings' ? 'active' : ''))
                            i.fas.fa-calendar-alt.me-1
                            | My Bookings
            
            ul.navbar-nav.ms-auto.align-items-center
                if user
                    li.nav-item.dropdown
                        a.nav-link.dropdown-toggle.btn.btn-light.px-3(href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false")
                            i.fas.fa-user-circle.me-2
                            | #{user.name}
                        ul.dropdown-menu.dropdown-menu-end.shadow-lg.border-0(aria-labelledby="navbarDropdown")
                            if user.role === 'partner'
                                li: a.dropdown-item(href="/partner/dashboard")
                                    i.fas.fa-chart-line.me-2
                                    | Partner Dashboard
                            if user.role === 'admin'
                                li: a.dropdown-item(href="/admin/dashboard")
                                    i.fas.fa-user-shield.me-2
                                    | Admin Panel
                            if user.role === 'customer'
                                li: a.dropdown-item(href="/profile")
                                    i.fas.fa-user-cog.me-2
                                    | My Profile
                            li: hr.dropdown-divider
                            li: a.dropdown-item.text-danger(href="/logout")
                                i.fas.fa-sign-out-alt.me-2
                                | Logout
                else
                    li.nav-item
                        a.nav-link(href="/customer/login") Login
                    li.nav-item.ms-lg-2
                        a.btn.btn-primary(href="/signup") Get Started
