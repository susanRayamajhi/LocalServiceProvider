                    li.list-inline-item: i.fab.fa-cc-visa.fa-2x.text-white-50
                    li.list-inline-item: i.fab.fa-cc-mastercard.fa-2x.text-white-50
                    li.list-inline-item: i.fab.fa-cc-paypal.fa-2x.text-white-50
