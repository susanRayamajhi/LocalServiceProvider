extends layouts/main.pug

block content
    .container.mt-5
        .row
            .col-lg-8.mx-auto
                .card.shadow-lg
                    .card-body.text-center
                        h1.display-4.mb-3= provider.name
                        span.badge.bg-success.mb-3 Rating: #{provider.rating} / 5.00
                        p.lead.mb-4= provider.description
                        
                        .row.mb-4
                            .col-md-6.text-md-end.fw-bold Email:
                            .col-md-6.text-md-start= provider.email
                            .col-md-6.text-md-end.fw-bold Phone:
                            .col-md-6.text-md-start= provider.phone
                        
                        hr
                        
                        h3 Services Offered
                        if services.length > 0
                            .row.justify-content-center.mt-4
                                each service in services
                                    .col-md-4.mb-3
                                        .card.bg-light
                                            .card-body
                                                h6.card-title= service.name
                                                .d-flex.justify-content-between
                                                    a.btn.btn-sm.btn-link.p-0(href=`/services/${service.id}`) Details
                                                    a.btn.btn-sm.btn-success.py-0(href=`/book/${service.id}`) Book
                        else
                            p.text-muted No services listed for this provider.
                        
                        .mt-4
                            a.btn.btn-secondary(href="/providers") Back to Providers
